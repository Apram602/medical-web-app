# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env to GitHub.

# OpenAI API key (create one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=docongo_users

# Secret used to sign login tokens (pick a long random string)
JWT_SECRET=

# Gmail account used for the contact form (needs a Gmail App Password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
